{
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "FIN-504: batch ordinary updates in the weekly window",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "weekly dependencies",
      "groupSlug": "weekly-dependencies"
    },
    {
      "description": "Go compiler and toolchain directives remain manual",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain"
      ],
      "enabled": false
    },
    {
      "description": "Go toolchains in reusable workflows and container images remain manual",
      "matchPackageNames": [
        "actions/go-versions",
        "golang",
        "library/golang",
        "docker.io/library/golang",
        "golang/go"
      ],
      "enabled": false
    }
  ]
}
